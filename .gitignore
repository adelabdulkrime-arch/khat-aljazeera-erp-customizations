# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
.venv/
venv/
env/
ENV/

# ---- Editors / IDE ----
.vscode/
.idea/
*.swp
*.swo
*~
*.sublime-*

# ---- OS junk ----
.DS_Store
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# ---- Logs / temp ----
*.log
*.tmp
*.bak
*.orig

# ---- Frappe / ERPNext runtime & secrets (should never be committed) ----
# هذا المستودع يحتوي فقط على سكربتات التخصيص، وليس تطبيق Frappe كاملاً.
sites/
config/
logs/
*.sql
*.sql.gz
*.tar
*.tar.gz
site_config.json
common_site_config.json
.env
.env.*
!.env.example
*.key
*.pem

# ---- Backups ----
erp-backups/
backups/
*.backup

# ---- تطبيق سطح المكتب (Electron) ----
desktop/node_modules/
desktop/release/
# قاعدة `build/` بالأعلى تخص بايثون، وهي تستبعد مجلد أيقونات التطبيق أيضاً.
# الأيقونة مولّدة من أيقونة الـPWA عبر build-icon.js، فلا داعي لحفظها، لكن
# المجلد نفسه لازم يبقى معروفاً لأداة البناء (buildResources).
!desktop/build/
desktop/build/*
!desktop/build/.gitkeep

# سجلات مؤقتة من اختبار التطبيق المكتبي
desktop/*.txt
