# Caddy يصدر شهادة HTTPS تلقائياً ويجدّدها، ويمرّر الطلبات لحاوية frontend.
{
	email {$ACME_EMAIL}
}

{$SITE_NAME} {
	encode zstd gzip

	# مسار websocket الخاص بـFrappe (الإشعارات الفورية وتحديث القوائم).
	# لازم يسبق القاعدة العامة، وإلا وصلت طلباته لـnginx بدل socket.io.
	handle /socket.io/* {
		reverse_proxy websocket:9000
	}

	# تخزين الأصول في المتصفح.
	#
	# الأصول تُقدَّم بلا ترويسة Cache-Control، فالمتصفح يُعيد التحقق من كل
	# ملف في كل زيارة. على اتصال بطيء هذا مكلف: قِيس التحميل من اتصال
	# ~0.9Mbps فبلغ 20 ثانية لـ2.3MB عبر 61 طلباً.
	#
	# أسماء الحزم تحمل بصمة محتواها (desk.bundle.BVJUULUA.js)، فأي تعديل
	# يغيّر الاسم ويُبطل التخزين تلقائياً — ولهذا immutable آمنة هنا ولا
	# تُجمّد نسخة قديمة عند التحديث. ملفاتنا (/assets/khat_workshop) بلا
	# بصمة، فتأخذ يوماً واحداً: طويل بما يكفي ليفيد، وقصير بما يكفي ليصل
	# أي تعديل خلال يوم.
	@fingerprinted path_regexp \.[A-Z0-9]{8}\.(js|css)$
	header @fingerprinted Cache-Control "public, max-age=31536000, immutable"

	# ملفاتنا بلا بصمة في أسمائها (rtl_fixes.css يبقى rtl_fixes.css مهما
	# تغيّر محتواه)، فالتخزين الطويل يؤجّل وصول أي إصلاح بقدر مدّته —
	# حدث فعلاً: تعديل على الشاشة بقي غير مرئي لأن المتصفح يحمل نسخة
	# الأمس. must-revalidate يجعل المتصفح يسأل الخادم في كل مرة، والخادم
	# يردّ 304 بلا جسم إن لم يتغيّر الملف — فالتوفير يبقى والتحديث فوري.
	@ourassets {
		path /assets/khat_workshop/*
		not query v=*
	}
	header @ourassets Cache-Control "public, max-age=0, must-revalidate"

	# ما يُضمَّن في الصفحات من ملفاتنا يحمل بصمة محتواه في العنوان (‎?v=…‎، من
	# hooks.py): يُخزَّن بلا مراجعة كحزم الإطار، والتعديل يغيّر العنوان. المراجعة
	# في كل تحميل كلّفت عشرة طلبات تسبق رسم الصفحة.
	@ourversioned {
		path /assets/khat_workshop/*
		query v=*
	}
	header @ourversioned Cache-Control "public, max-age=31536000, immutable"

	# mp3: أصوات التنبيه التسعة، يحمّلها المكتب مع كل صفحة
	@media path *.png *.jpg *.jpeg *.svg *.woff *.woff2 *.ico *.mp3
	header @media Cache-Control "public, max-age=604800"

	handle {
		reverse_proxy frontend:8080 {
			# nginx داخل frontend مضبوط على قراءة X-Forwarded-For (راجع
			# UPSTREAM_REAL_IP_HEADER بـdocker-compose.yml) ليظهر IP المستخدم
			# الحقيقي في سجلات Frappe بدل IP البروكسي.
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
			header_up Host {host}
		}
	}

	# رفع الملفات (مرفقات، صور قطع الغيار) — يطابق CLIENT_MAX_BODY_SIZE=50m
	request_body {
		max_size 50MB
	}
}

# المواقع الأخرى على هذا الخادم (المنقولة من Hostinger). كل موقع في ملفه
# ‎~/webhost/caddy/<الدومين>.caddy‎ وملفاته في ‎~/webhost/sites/<الدومين>‎ — خارج
# هذا المستودع، فإضافة موقع أو حذفه لا تمسّ النظام. بلا ملفات لا يُستورد شيء.
import /etc/caddy/sites/*.caddy
