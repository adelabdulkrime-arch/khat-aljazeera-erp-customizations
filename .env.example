# Copy this file to .env and fill in the values before running locally.
# In Coolify, add these as Environment Variables in the app's settings.
# Never commit the actual .env file — it is gitignored.

# ── Site & Admin ─────────────────────────────────────────────────────────────
# BARE HOSTNAME ONLY — no http://, no https://, no trailing slash.
# Must exactly match the domain Coolify assigns to the `frontend` service.
# The Frappe site directory, DB name, and nginx Host header all use this value,
# so any scheme prefix here breaks BOTH site creation and request routing.
#   correct:   erp.yourdomain.com
#   correct:   m4tgf5pizetktfnuiyvsc6j6.187.127.93.222.sslip.io
#   WRONG:     http://erp.yourdomain.com
SITE_NAME=erp.yourdomain.com

ADMIN_PASSWORD=change-me-strong-password

# ── Workshop manager account (the client) ────────────────────────────────────
# The client's login: username Admin (the record is khataljazeera@gmail.com),
# roles مدير النظام + مدير الورشة.
#
# This value is the account's FIRST password only: it is applied when the
# account has none. A password changed later from the UI is never overwritten
# by a deploy. Leave it empty and a new account is created without a password.
# See khat_workshop/setup/workshop_demo_user.py.
DEMO_USER_PASSWORD=change-me-trial-password

# ── Database ──────────────────────────────────────────────────────────────────
DB_ROOT_PASSWORD=change-me-root-password
# Password for the per-site MariaDB user created by bench new-site
MYSQL_PASSWORD=change-me-site-db-password

# ── ERPNext image tag ─────────────────────────────────────────────────────────
# Check https://github.com/frappe/frappe_docker/releases for available tags.
ERPNEXT_VERSION=v16

# ── نشر على VPS عادي (Oracle Cloud وغيره) عبر docker-compose.caddy.yml ───────
# بريد لتنبيهات Let's Encrypt عند قرب انتهاء الشهادة. غير مستخدم مع Coolify
# (Traefik يتولّى الشهادات هناك). راجع ORACLE_DEPLOY.md
ACME_EMAIL=you@example.com
